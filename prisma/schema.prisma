// XavierConnect database schema
// Conventions:
//  * Money is stored as BigInt in minor units (kobo for NGN). Never Float.
//  * Every table has createdAt; mutable tables have updatedAt.
//  * Soft deletion (deletedAt) on user-facing catalogue entities only.
//  * Ledger tables are append-only (enforced by a DB trigger in the init migration).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a session connection; runtime traffic can use the transaction pooler.
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Identity & access ─────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  phone            String?
  name             String
  passwordHash     String? // null for accounts created with Google sign-in only
  status           UserStatus @default(ACTIVE)
  lastSeenAt       DateTime? // messaging presence, updated at most every 30 s
  emailVerifiedAt  DateTime?
  mfaSecret        String?
  mfaEnabledAt     DateTime?
  mfaRecoveryCodes String[] // sha256 hashes of one-time recovery codes
  lastLoginAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  roles                      UserRole[]
  sessions                   Session[]
  tokens                     VerificationToken[]
  vendorsOwned               Vendor[]                   @relation("VendorOwner")
  addresses                  Address[]
  cart                       Cart?
  orders                     Order[]
  wishlist                   WishlistItem[]
  follows                    StoreFollow[]
  reviews                    Review[]
  notifications              Notification[]
  notificationPrefs          NotificationPreference[]
  bookings                   Booking[]
  conversations              Conversation[]             @relation("ConversationCustomer")
  conversationParticipations ConversationParticipant[]
  messageReadReceipts        MessageReadReceipt[]
  messageReports             MessageReport[]            @relation("MessageReporter")
  moderationEvents           ModerationEvent[]          @relation("ModerationSubject")
  messagingRestrictions      UserMessagingRestriction[] @relation("RestrictedUser")
  externalIdentities         ExternalIdentityAccount[]
  oauthLinkEvents            OAuthAccountLink[]
  messagesSent               Message[]
  tickets                    SupportTicket[]            @relation("TicketOwner")
  ticketsAssigned            SupportTicket[]            @relation("TicketAssignee")
  ticketMessages             TicketMessage[]
  disputesOpened             Dispute[]                  @relation("DisputeOpener")
  auditLogs                  AuditLog[]
  downloadGrants             DownloadGrant[]
  shipmentsAssigned          Shipment[]
  reports                    Report[]
  blogPosts                  BlogPost[]
  reviewVotes                ReviewVote[]
  payoutsReviewed            Payout[]                   @relation("PayoutReviewer")
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique // e.g. SUPER_ADMIN, CUSTOMER, VENDOR
  name        String
  description String?
  isStaff     Boolean          @default(false)
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique // e.g. vendor.approve, finance.payout.approve
  name  String
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

/// A user's role. vendorId scopes VENDOR / VENDOR_STAFF / SERVICE_PROVIDER roles to one vendor.
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  vendorId  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  vendor    Vendor?  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, vendorId])
  @@index([vendorId])
}

model Session {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  userId        String
  expiresAt     DateTime
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  mfaVerifiedAt DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String?
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  country    String   @default("NG")
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── Vendors & stores ─────────────────────────────

enum VendorType {
  INDIVIDUAL
  BUSINESS
  SERVICE_PROVIDER
}

enum VendorStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
}

enum VerificationLevel {
  BASIC
  IDENTITY_VERIFIED
  BUSINESS_VERIFIED
  PREMIUM_VERIFIED
}

model Vendor {
  id                    String            @id @default(cuid())
  ownerId               String
  type                  VendorType
  status                VendorStatus      @default(DRAFT)
  verificationLevel     VerificationLevel @default(BASIC)
  businessName          String
  description           String?
  businessCategory      String?
  email                 String
  phone                 String
  website               String?
  socialLinks           Json?
  addressLine1          String?
  city                  String?
  state                 String?
  country               String            @default("NG")
  rcNumber              String? // CAC registration number for registered businesses
  region                String? // state/province for non-NG vendors
  payoutCurrency        String            @default("NGN")
  handlingDays          Int               @default(1)
  internationalShipping Boolean           @default(false)
  onboardingStep        Int               @default(1)
  agreementAcceptedAt   DateTime?
  agreementVersion      String?
  submittedAt           DateTime?
  reviewedAt            DateTime?
  reviewNote            String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  owner           User                @relation("VendorOwner", fields: [ownerId], references: [id])
  store           Store?
  members         UserRole[]
  documents       VendorDocument[]
  products        Product[]
  services        Service[]
  vendorOrders    VendorOrder[]
  bookings        Booking[]
  shippingMethods ShippingMethod[]
  payouts         Payout[]
  payoutAccount   PayoutAccount?
  commissionRules CommissionRule[]
  ledgerAccounts  LedgerAccount[]
  beneficiaries   Beneficiary[]
  pickupAddresses PickupAddress[]
  coupons         Coupon[]
  conversations   Conversation[]
  subscription    VendorSubscription?
  reviews         Review[]

  @@index([status])
  @@index([ownerId])
}

enum DocumentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model VendorDocument {
  id         String         @id @default(cuid())
  vendorId   String
  type       String // GOVERNMENT_ID, CAC_CERTIFICATE, UTILITY_BILL, ...
  fileKey    String // private storage key, never a public URL
  fileName   String
  status     DocumentStatus @default(PENDING)
  reviewNote String?
  createdAt  DateTime       @default(now())
  vendor     Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model Store {
  id            String        @id @default(cuid())
  vendorId      String        @unique
  slug          String        @unique
  name          String
  tagline       String?
  description   String?
  logoUrl       String?
  bannerUrl     String?
  contactEmail  String?
  contactPhone  String?
  city          String?
  state         String?
  businessHours Json?
  returnPolicy  String?
  shippingNote  String?
  layout        String        @default("standard")
  ratingAvg     Float         @default(0) // display cache only, recomputed from reviews
  ratingCount   Int           @default(0)
  isFeatured    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  vendor        Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  followers     StoreFollow[]
}

model StoreFollow {
  userId    String
  storeId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
}

// ───────────────────────────── Catalogue ─────────────────────────────

enum CategoryKind {
  PRODUCT
  SERVICE
  DIGITAL
}

model Category {
  id              String           @id @default(cuid())
  parentId        String?
  kind            CategoryKind
  slug            String           @unique
  name            String
  description     String?
  imageUrl        String?
  sortOrder       Int              @default(0)
  isFeatured      Boolean          @default(false)
  createdAt       DateTime         @default(now())
  parent          Category?        @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[]       @relation("CategoryTree")
  products        Product[]
  services        Service[]
  commissionRules CommissionRule[]

  @@index([kind, parentId])
}

enum ProductType {
  PHYSICAL
  DIGITAL
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

model Product {
  id                String        @id @default(cuid())
  vendorId          String
  categoryId        String
  type              ProductType   @default(PHYSICAL)
  status            ListingStatus @default(DRAFT)
  name              String
  slug              String        @unique
  sku               String?
  brand             String?
  shortDescription  String?
  description       String
  priceMinor        BigInt
  salePriceMinor    BigInt?
  currency          String        @default("NGN")
  stockQuantity     Int           @default(0)
  trackInventory    Boolean       @default(true)
  lowStockThreshold Int           @default(5)
  weightGrams       Int?
  lengthCm          Int?
  widthCm           Int?
  heightCm          Int?
  attributes        Json? // { material: "...", model: "..." }
  tags              String[]
  shippingInfo      String?
  returnInfo        String?
  warranty          String?
  videoUrl          String?
  seoTitle          String?
  seoDescription    String?
  publishAt         DateTime?
  rejectionReason   String?
  isFeatured        Boolean       @default(false)
  ratingAvg         Float         @default(0)
  ratingCount       Int           @default(0)
  salesCount        Int           @default(0)
  viewCount         Int           @default(0)
  licenceTerms      String? // digital products
  refundable        Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  vendor          Vendor                 @relation(fields: [vendorId], references: [id])
  category        Category               @relation(fields: [categoryId], references: [id])
  images          ProductImage[]
  variants        ProductVariant[]
  digitalAssets   DigitalAsset[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  reviews         Review[]
  wishlist        WishlistItem[]
  reservations    InventoryReservation[]
  questions       ProductQuestion[]
  commissionRules CommissionRule[]

  @@index([status, categoryId])
  @@index([vendorId, status])
  @@index([createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  sku           String?
  name          String // "Black / XL"
  options       Json // { colour: "Black", size: "XL" }
  priceMinor    BigInt? // overrides product price when set
  stockQuantity Int      @default(0)
  createdAt     DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductQuestion {
  id         String    @id @default(cuid())
  productId  String
  userId     String
  question   String
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
}

/// Stock held for an unpaid order. Committed on payment, released on failure/expiry.
model InventoryReservation {
  id        String            @id @default(cuid())
  productId String
  variantId String?
  orderId   String
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  product   Product           @relation(fields: [productId], references: [id])
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([orderId])
}

model DigitalAsset {
  id        String          @id @default(cuid())
  productId String
  fileKey   String // private storage key
  fileName  String
  format    String
  sizeBytes Int
  version   String          @default("1.0")
  createdAt DateTime        @default(now())
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  grants    DownloadGrant[]
}

model DownloadGrant {
  id            String       @id @default(cuid())
  userId        String
  assetId       String
  orderItemId   String
  maxDownloads  Int          @default(5)
  downloadsUsed Int          @default(0)
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime     @default(now())
  user          User         @relation(fields: [userId], references: [id])
  asset         DigitalAsset @relation(fields: [assetId], references: [id])
  orderItem     OrderItem    @relation(fields: [orderItemId], references: [id])

  @@unique([orderItemId, assetId])
  @@index([userId])
}

// ───────────────────────────── Services & bookings ─────────────────────────────

enum ServicePricing {
  FIXED
  HOURLY
}

enum ServiceLocation {
  ONSITE
  REMOTE
  BOTH
}

model Service {
  id                 String          @id @default(cuid())
  vendorId           String
  categoryId         String
  status             ListingStatus   @default(DRAFT)
  title              String
  slug               String          @unique
  summary            String?
  description        String
  pricing            ServicePricing  @default(FIXED)
  location           ServiceLocation @default(ONSITE)
  city               String?
  state              String?
  cancellationPolicy String?
  portfolio          Json? // [{ url, caption }]
  ratingAvg          Float           @default(0)
  ratingCount        Int             @default(0)
  isFeatured         Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  vendor       Vendor                @relation(fields: [vendorId], references: [id])
  category     Category              @relation(fields: [categoryId], references: [id])
  packages     ServicePackage[]
  availability ServiceAvailability[]
  bookings     Booking[]
  reviews      Review[]

  @@index([status, categoryId])
  @@index([vendorId])
}

enum PackageTier {
  BASIC
  STANDARD
  PREMIUM
}

model ServicePackage {
  id              String      @id @default(cuid())
  serviceId       String
  tier            PackageTier
  name            String
  description     String
  priceMinor      BigInt
  durationMinutes Int         @default(60)
  deliveryDays    Int?
  service         Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookings        Booking[]

  @@unique([serviceId, tier])
}

/// Weekly opening hours. Minutes from midnight, Africa/Lagos local time.
model ServiceAvailability {
  id          String  @id @default(cuid())
  serviceId   String
  weekday     Int // 0 = Sunday
  startMinute Int
  endMinute   Int
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, weekday])
}

enum BookingStatus {
  PENDING_PAYMENT
  REQUESTED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

model Booking {
  id           String         @id @default(cuid())
  number       String         @unique
  serviceId    String
  packageId    String
  vendorId     String
  customerId   String
  orderItemId  String?        @unique
  startAt      DateTime
  endAt        DateTime
  status       BookingStatus  @default(PENDING_PAYMENT)
  notes        String?
  address      String?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  service      Service        @relation(fields: [serviceId], references: [id])
  package      ServicePackage @relation(fields: [packageId], references: [id])
  vendor       Vendor         @relation(fields: [vendorId], references: [id])
  customer     User           @relation(fields: [customerId], references: [id])
  orderItem    OrderItem?     @relation(fields: [orderItemId], references: [id])

  @@index([serviceId, startAt])
  @@index([vendorId, status])
  @@index([customerId])
}

// ───────────────────────────── Cart & orders ─────────────────────────────

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  guestToken String?    @unique
  couponCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  productId  String
  variantKey String   @default("") // variant id or "" — avoids NULL-distinct unique issue
  quantity   Int
  createdAt  DateTime @default(now())
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantKey])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// Parent customer order. One per checkout.
model Order {
  id              String        @id @default(cuid())
  number          String        @unique // XC-10001
  userId          String?
  guestEmail      String?
  status          OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus   PaymentStatus @default(UNPAID)
  currency        String        @default("NGN")
  subtotalMinor   BigInt
  discountMinor   BigInt        @default(0)
  shippingMinor   BigInt        @default(0)
  taxMinor        BigInt        @default(0)
  totalMinor      BigInt
  couponCode      String?
  shippingAddress Json?
  contactPhone    String?
  paidAt          DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user         User?                  @relation(fields: [userId], references: [id])
  vendorOrders VendorOrder[]
  items        OrderItem[]
  payments     Payment[]
  refunds      Refund[]
  reservations InventoryReservation[]
  disputes     Dispute[]

  @@index([userId, createdAt])
  @@index([status])
}

enum VendorOrderStatus {
  AWAITING_PAYMENT
  NEW
  PROCESSING
  READY_FOR_DISPATCH
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  RETURN_REQUESTED
  REFUNDED
}

/// One vendor's slice of a customer order. Vendors only ever see their own.
model VendorOrder {
  id                 String            @id @default(cuid())
  number             String            @unique // XC-10001-A
  orderId            String
  vendorId           String
  status             VendorOrderStatus @default(AWAITING_PAYMENT)
  subtotalMinor      BigInt
  discountMinor      BigInt            @default(0)
  shippingMinor      BigInt            @default(0)
  taxMinor           BigInt            @default(0)
  totalMinor         BigInt
  commissionMinor    BigInt            @default(0)
  vendorNetMinor     BigInt            @default(0)
  shippingMethodId   String?
  deliveredAt        DateTime?
  deliveryEvidence   String? // CARRIER | RIDER_POD | CUSTOMER_CONFIRMED | DIGITAL | SERVICE_COMPLETED | VENDOR_CLAIM | ADMIN
  settlementCurrency String            @default("NGN")
  processingFeeMinor BigInt            @default(0)
  settledAt          DateTime? // when earnings moved pending -> available
  shippingQuoteId    String? // carrier quote the customer chose at checkout (null = seller-configured rate)
  shippingCostMinor  BigInt? // what the carrier quoted XavierConnect (excl. markup)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  order           Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor          Vendor             @relation(fields: [vendorId], references: [id])
  items           OrderItem[]
  shipments       Shipment[]
  shippingReturns ShippingReturn[]
  refunds         Refund[]
  disputes        Dispute[]
  events          VendorOrderEvent[]

  @@index([vendorId, status])
  @@index([orderId])
}

model VendorOrderEvent {
  id            String            @id @default(cuid())
  vendorOrderId String
  status        VendorOrderStatus
  note          String?
  actorId       String?
  createdAt     DateTime          @default(now())
  vendorOrder   VendorOrder       @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  @@index([vendorOrderId])
}

enum OrderItemKind {
  PHYSICAL
  DIGITAL
  SERVICE
}

model OrderItem {
  id               String        @id @default(cuid())
  orderId          String
  vendorOrderId    String
  kind             OrderItemKind
  productId        String?
  variantId        String?
  name             String // snapshot
  sku              String?
  unitPriceMinor   BigInt
  quantity         Int
  lineTotalMinor   BigInt
  discountMinor    BigInt        @default(0)
  commissionMinor  BigInt        @default(0)
  commissionRuleId String?
  createdAt        DateTime      @default(now())

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorOrder    VendorOrder     @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id])
  downloadGrants DownloadGrant[]
  booking        Booking?
  shipmentItems  ShipmentItem[]
  review         Review?

  @@index([orderId])
  @@index([vendorOrderId])
}

// ───────────────────────────── Payments & finance ─────────────────────────────

enum PaymentAttemptStatus {
  INITIATED
  SUCCEEDED
  FAILED
  ABANDONED
}

model Payment {
  id              String               @id @default(cuid())
  orderId         String
  provider        String // sandbox | paystack | flutterwave
  reference       String               @unique
  amountMinor     BigInt
  currency        String               @default("NGN")
  status          PaymentAttemptStatus @default(INITIATED)
  channel         String?
  feesMinor       BigInt               @default(0)
  providerPayload Json?
  failureReason   String?
  verifiedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  order           Order                @relation(fields: [orderId], references: [id])
  refunds         Refund[]

  @@index([orderId])
}

/// Every webhook we receive. Unique (provider, eventKey) makes processing idempotent.
model PaymentEvent {
  id             String    @id @default(cuid())
  provider       String
  eventKey       String
  type           String
  payload        Json
  signatureOk    Boolean
  kind           String    @default("PAYMENT") // PAYMENT | PAYOUT | SHIPPING
  attempts       Int       @default(0)
  nextRetryAt    DateTime?
  deadLetteredAt DateTime?
  processedAt    DateTime?
  error          String?
  createdAt      DateTime  @default(now())

  @@unique([provider, eventKey])
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
}

model Refund {
  id             String       @id @default(cuid())
  orderId        String
  vendorOrderId  String?
  paymentId      String?
  amountMinor    BigInt
  reason         String
  status         RefundStatus @default(REQUESTED)
  idempotencyKey String       @unique
  providerRef    String?
  requestedById  String?
  decidedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  order          Order        @relation(fields: [orderId], references: [id])
  vendorOrder    VendorOrder? @relation(fields: [vendorOrderId], references: [id])
  payment        Payment?     @relation(fields: [paymentId], references: [id])
}

enum CommissionScope {
  GLOBAL
  SUBSCRIPTION
  CATEGORY
  VENDOR
  PRODUCT
}

/// Most specific active rule wins: PRODUCT > VENDOR > CATEGORY > SUBSCRIPTION > GLOBAL.
model CommissionRule {
  id         String          @id @default(cuid())
  scope      CommissionScope
  name       String
  rateBps    Int             @default(0) // 1000 = 10%
  fixedMinor BigInt          @default(0) // per item unit
  categoryId String?
  vendorId   String?
  productId  String?
  planKey    String?
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  category   Category?       @relation(fields: [categoryId], references: [id])
  vendor     Vendor?         @relation(fields: [vendorId], references: [id])
  product    Product?        @relation(fields: [productId], references: [id])

  @@index([scope, active])
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
}

model LedgerAccount {
  id        String            @id @default(cuid())
  code      String            @unique // platform:clearing, vendor:<id>:pending ...
  name      String
  type      LedgerAccountType
  vendorId  String?
  currency  String            @default("NGN")
  createdAt DateTime          @default(now())
  vendor    Vendor?           @relation(fields: [vendorId], references: [id])
  entries   LedgerEntry[]

  @@index([vendorId])
}

/// A balanced set of entries. Immutable once written. Corrections are new reversing transactions.
model LedgerTransaction {
  id             String        @id @default(cuid())
  kind           String // PAYMENT_CAPTURED, SETTLEMENT_RELEASE, PAYOUT, REFUND, REVERSAL
  reference      String // order number, payout id, etc.
  idempotencyKey String        @unique
  description    String
  createdAt      DateTime      @default(now())
  entries        LedgerEntry[]

  @@index([reference])
}

model LedgerEntry {
  id            String            @id @default(cuid())
  transactionId String
  accountId     String
  debitMinor    BigInt            @default(0)
  creditMinor   BigInt            @default(0)
  createdAt     DateTime          @default(now())
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])
  account       LedgerAccount     @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([transactionId])
}

model PayoutAccount {
  id                    String    @id @default(cuid())
  vendorId              String    @unique
  bankName              String
  bankCode              String
  accountName           String
  accountNumberLast4    String // full number is held by the payment provider, not here
  providerRecipientCode String?
  verifiedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  vendor                Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PROCESSING
  PAID
  FAILED
  REJECTED
}

model Payout {
  id                    String        @id @default(cuid())
  vendorId              String
  amountMinor           BigInt
  status                PayoutStatus  @default(REQUESTED)
  idempotencyKey        String        @unique
  currency              String        @default("NGN") // ledger currency the amount is held in
  beneficiaryId         String?
  providerKey           String? // "manual" = finance pays by bank transfer and records the reference
  method                String        @default("LOCAL") // LOCAL | CROSS_BORDER
  settlementCurrency    String?
  settlementAmountMinor BigInt?
  fxRate                Decimal?      @db.Decimal(24, 12)
  providerFeeMinor      BigInt        @default(0)
  initiatedAt           DateTime?
  providerRef           String?
  failureReason         String?
  reviewedById          String?
  reviewedAt            DateTime?
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  vendor                Vendor        @relation(fields: [vendorId], references: [id])
  reviewedBy            User?         @relation("PayoutReviewer", fields: [reviewedById], references: [id])
  beneficiary           Beneficiary?  @relation(fields: [beneficiaryId], references: [id])
  events                PayoutEvent[]
  fxQuote               FxQuote?

  @@index([vendorId, status])
}

// ───────────────────────────── Shipping ─────────────────────────────

enum ShippingRateType {
  FLAT
  WEIGHT
  PICKUP
}

model ShippingMethod {
  id                   String           @id @default(cuid())
  vendorId             String
  name                 String
  type                 ShippingRateType
  rateMinor            BigInt           @default(0)
  perKgMinor           BigInt           @default(0)
  freeOverMinor        BigInt? // free shipping when vendor subtotal >= this
  states               String[] // empty = nationwide
  destinationCountries String[] // empty = vendor's own country only
  etaDaysMin           Int              @default(1)
  etaDaysMax           Int              @default(5)
  active               Boolean          @default(true)
  vendor               Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

enum ShipmentStatus {
  PENDING
  AWAITING_PICKUP
  PICKED_UP
  IN_TRANSIT
  AT_SORTING_FACILITY
  CUSTOMS_PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_ATTEMPT // "Delivery failed"
  RETURNED // "Returned to sender"
  CANCELLED
}

model Shipment {
  id                  String                @id @default(cuid())
  vendorOrderId       String
  carrier             String                @default("Vendor delivery")
  trackingNumber      String?
  status              ShipmentStatus        @default(PENDING)
  deliveryPartnerId   String?
  proofOfDeliveryKey  String?
  recipientName       String?
  providerKey         String?
  providerShipmentId  String?
  service             String?
  costMinor           BigInt?
  costCurrency        String?
  labelUrl            String?
  trackingUrl         String?
  international       Boolean               @default(false)
  originCountry       String?
  destinationCountry  String?
  weightGrams         Int?
  lastEventAt         DateTime?
  failureReason       String?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  method              String? // SELLER | LOCAL_DISPATCH | STANDARD | EXPRESS | AIR_FREIGHT | SEA_FREIGHT
  leg                 String                @default("DIRECT") // DIRECT | TO_WAREHOUSE | CONSOLIDATED | LAST_MILE | RETURN
  quoteId             String? // ShippingQuote the label was bought from
  idempotencyKey      String?               @unique // one booking per sub-order/quote, even on double-submit
  originAddress       Json? // snapshot at booking
  destinationAddress  Json? // snapshot at booking
  estimatedDeliveryAt DateTime?
  pickupScheduledAt   DateTime?
  pickupRef           String?
  cancelledAt         DateTime?
  cancelReason        String?
  lastPolledAt        DateTime?
  consolidationId     String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  vendorOrder         VendorOrder           @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  deliveryPartner     User?                 @relation(fields: [deliveryPartnerId], references: [id])
  events              ShipmentEvent[]
  customs             CustomsDeclaration?
  items               ShipmentItem[]
  labels              ShipmentLabel[]
  consolidation       FreightConsolidation? @relation(fields: [consolidationId], references: [id])
  warehouseReceipt    WarehouseReceipt?
  invoices            ShippingInvoice[]
  returnFor           ShippingReturn?       @relation("ReturnShipment")

  @@index([deliveryPartnerId, status])
  @@index([vendorOrderId])
  @@index([status, lastEventAt])
  @@index([providerKey, providerShipmentId])
}

model ShipmentEvent {
  id              String         @id @default(cuid())
  providerEventId String?        @unique
  shipmentId      String
  status          ShipmentStatus
  location        String?
  note            String?
  createdAt       DateTime       @default(now())
  shipment        Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Engagement ─────────────────────────────

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  FLAGGED
}

model Review {
  id             String       @id @default(cuid())
  userId         String
  vendorId       String
  productId      String?
  serviceId      String?
  orderItemId    String?      @unique // one review per purchased line
  rating         Int // 1..5
  title          String?
  body           String
  verified       Boolean      @default(false)
  status         ReviewStatus @default(PUBLISHED)
  vendorResponse String?
  helpfulCount   Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id])
  vendor         Vendor       @relation(fields: [vendorId], references: [id])
  product        Product?     @relation(fields: [productId], references: [id])
  service        Service?     @relation(fields: [serviceId], references: [id])
  orderItem      OrderItem?   @relation(fields: [orderItemId], references: [id])
  votes          ReviewVote[]

  @@index([productId, status])
  @@index([serviceId, status])
}

model ReviewVote {
  reviewId String
  userId   String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
}

model WishlistItem {
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model Conversation {
  id                  String                    @id @default(cuid())
  customerId          String
  vendorId            String
  subject             String
  orderId             String?
  bookingId           String?
  productId           String? // context the conversation was started from
  serviceId           String?
  blockedByCustomerAt DateTime? // customer blocked this store
  blockedByVendorAt   DateTime? // store blocked this customer
  lastMessageAt       DateTime                  @default(now())
  createdAt           DateTime                  @default(now())
  customer            User                      @relation("ConversationCustomer", fields: [customerId], references: [id])
  vendor              Vendor                    @relation(fields: [vendorId], references: [id])
  messages            Message[]
  participants        ConversationParticipant[]
  reports             MessageReport[]
  notifications       MessageNotification[]

  @@index([customerId])
  @@index([vendorId])
  @@index([customerId, lastMessageAt])
  @@index([vendorId, lastMessageAt])
}

/**
 * Per-user state in a conversation (read position, archive, typing). Side decides who may act.
 */
model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  side           String // CUSTOMER | VENDOR
  lastReadAt     DateTime?
  archivedAt     DateTime?
  typingUntil    DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id               String               @id @default(cuid())
  conversationId   String
  senderId         String
  body             String
  attachmentUrl    String? // legacy, unused
  readAt           DateTime? // legacy, unused (see MessageReadReceipt)
  senderSide       String               @default("CUSTOMER") // CUSTOMER | VENDOR
  status           MessageStatus        @default(DELIVERED)
  moderation       ModerationDecision   @default(APPROVED)
  productId        String? // product reference shown as a card
  orderId          String? // order reference shown as a card
  deliveredAt      DateTime? // set only when the recipient may see it
  createdAt        DateTime             @default(now())
  conversation     Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender           User                 @relation(fields: [senderId], references: [id])
  attachments      MessageAttachment[]
  receipts         MessageReadReceipt[]
  reports          MessageReport[]
  moderationEvents ModerationEvent[]

  @@index([conversationId, createdAt])
  @@index([conversationId, deliveredAt])
  @@index([status, createdAt])
}

enum MessageStatus {
  DELIVERED // visible to both sides
  HELD // REVIEW: waiting for a moderator, visible only to the sender
  BLOCKED // never delivered
}

enum ModerationDecision {
  APPROVED
  BLOCKED
  REVIEW
  ATTACHMENT_BLOCKED
}

enum AttachmentStatus {
  PENDING // being inspected
  APPROVED
  REVIEW // held for a moderator
  BLOCKED
}

/**
 * Private file. Served only through /messages/attachment/[id] after authorisation and approval.
 */
model MessageAttachment {
  id           String           @id @default(cuid())
  messageId    String
  uploaderId   String
  storageKey   String? // null once purged under the retention policy
  fileName     String
  mimeType     String
  size         Int
  sha256       String
  status       AttachmentStatus @default(PENDING)
  findings     Json? // detector categories (no raw matches)
  scanner      String? // e.g. "ocr+qr", "clamav", "none"
  scannedAt    DateTime?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())
  message      Message          @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([status, createdAt])
}

model MessageReadReceipt {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
}

model MessageReport {
  id             String       @id @default(cuid())
  conversationId String
  messageId      String?
  reporterId     String
  reason         String
  details        String?
  status         String       @default("OPEN") // OPEN | RESOLVED | DISMISSED
  resolvedById   String?
  resolution     String?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        Message?     @relation(fields: [messageId], references: [id])
  reporter       User         @relation("MessageReporter", fields: [reporterId], references: [id])

  @@index([status, createdAt])
}

/**
 * Every automatic or moderator decision. `confirmed` events count towards progressive enforcement.
 */
model ModerationEvent {
  id             String             @id @default(cuid())
  userId         String // the sender the decision is about
  conversationId String?
  messageId      String?
  attachmentId   String?
  decision       ModerationDecision
  categories     String[]
  detail         Json? // redacted findings, never full contact details
  source         String             @default("AUTO") // AUTO | MODERATOR
  confirmed      Boolean            @default(false)
  actorId        String?
  note           String?
  createdAt      DateTime           @default(now())
  user           User               @relation("ModerationSubject", fields: [userId], references: [id])
  message        Message?           @relation(fields: [messageId], references: [id])

  @@index([userId, createdAt])
  @@index([decision, createdAt])
}

/**
 * Admin-configurable rules: extra blocked/review terms, allowed domains, detector switches.
 */
model ModerationRule {
  id          String   @id @default(cuid())
  kind        String // BLOCK_TERM | REVIEW_TERM | ALLOW_DOMAIN | DETECTOR
  value       String
  enabled     Boolean  @default(true)
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([kind, value])
}

model UserMessagingRestriction {
  id          String    @id @default(cuid())
  userId      String
  kind        String // WARNING | MUTE | REVIEW_FLAG
  reason      String
  startsAt    DateTime  @default(now())
  endsAt      DateTime? // null = until lifted (MUTE set by a moderator)
  createdById String? // null = automatic
  liftedAt    DateTime?
  liftedById  String?
  createdAt   DateTime  @default(now())
  user        User      @relation("RestrictedUser", fields: [userId], references: [id])

  @@index([userId, kind, endsAt])
}

/**
 * Throttles new-message notifications to one per conversation until the recipient reads it.
 */
model MessageNotification {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastMessageId  String
  notifiedAt     DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

/**
 * A verified external identity (Google `sub`) linked to a user. One identity → one user.
 */
model ExternalIdentityAccount {
  id            String    @id @default(cuid())
  userId        String
  provider      String // "google"
  subject       String // OIDC `sub` — stable, never the email
  email         String?
  emailVerified Boolean   @default(false)
  name          String?
  linkedAt      DateTime  @default(now())
  lastLoginAt   DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

/**
 * History of link/unlink and refused sign-ins (audit).
 */
model OAuthAccountLink {
  id        String   @id @default(cuid())
  userId    String?
  provider  String
  subject   String
  action    String // LINKED | UNLINKED | SIGNED_UP | REFUSED
  reason    String?
  ip        String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([provider, subject])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model NotificationPreference {
  userId  String
  type    String
  channel String // in_app | email | sms
  enabled Boolean @default(true)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type, channel])
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

model EmailOutbox {
  id        String       @id @default(cuid())
  to        String
  subject   String
  text      String
  html      String?
  status    OutboxStatus @default(PENDING)
  attempts  Int          @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([status])
}

// ───────────────────────────── Marketing ─────────────────────────────

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id               String     @id @default(cuid())
  code             String     @unique
  vendorId         String? // null = platform-funded coupon
  type             CouponType
  value            Int // bps for PERCENT (1000 = 10%), minor units for FIXED
  minSubtotalMinor BigInt     @default(0)
  maxDiscountMinor BigInt?
  maxUses          Int?
  usedCount        Int        @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  active           Boolean    @default(true)
  createdAt        DateTime   @default(now())
  vendor           Vendor?    @relation(fields: [vendorId], references: [id])
}

model SubscriptionPlan {
  id            String               @id @default(cuid())
  key           String               @unique // STARTER, GROWTH, BUSINESS, ENTERPRISE
  name          String
  priceMinor    BigInt
  interval      String               @default("month")
  listingLimit  Int?
  commissionBps Int?
  features      String[]
  active        Boolean              @default(true)
  sortOrder     Int                  @default(0)
  subscriptions VendorSubscription[]
}

model VendorSubscription {
  id                String           @id @default(cuid())
  vendorId          String           @unique
  planId            String
  status            String           @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELLED, EXPIRED
  currentPeriodEnd  DateTime
  cancelAtPeriodEnd Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  vendor            Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  plan              SubscriptionPlan @relation(fields: [planId], references: [id])
}

model NewsletterSubscriber {
  id          String    @id @default(cuid())
  email       String    @unique
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
}

// ───────────────────────────── Support & trust ─────────────────────────────

enum TicketStatus {
  OPEN
  PENDING_CUSTOMER
  ESCALATED
  RESOLVED
  CLOSED
}

model SupportTicket {
  id           String          @id @default(cuid())
  number       String          @unique
  userId       String
  category     String
  priority     String          @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  subject      String
  status       TicketStatus    @default(OPEN)
  assignedToId String?
  orderNumber  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation("TicketOwner", fields: [userId], references: [id])
  assignedTo   User?           @relation("TicketAssignee", fields: [assignedToId], references: [id])
  messages     TicketMessage[]

  @@index([status, priority])
  @@index([userId])
}

model TicketMessage {
  id            String        @id @default(cuid())
  ticketId      String
  authorId      String
  body          String
  internal      Boolean       @default(false) // staff-only note
  attachmentUrl String?
  createdAt     DateTime      @default(now())
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author        User          @relation(fields: [authorId], references: [id])
}

enum DisputeStatus {
  OPEN
  AWAITING_VENDOR
  UNDER_REVIEW
  RESOLVED_CUSTOMER
  RESOLVED_VENDOR
  CLOSED
}

model Dispute {
  id            String            @id @default(cuid())
  orderId       String
  vendorOrderId String
  openedById    String
  reason        String
  description   String
  status        DisputeStatus     @default(OPEN)
  resolution    String?
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  order         Order             @relation(fields: [orderId], references: [id])
  vendorOrder   VendorOrder       @relation(fields: [vendorOrderId], references: [id])
  openedBy      User              @relation("DisputeOpener", fields: [openedById], references: [id])
  evidence      DisputeEvidence[]
}

model DisputeEvidence {
  id        String   @id @default(cuid())
  disputeId String
  authorId  String
  party     String // CUSTOMER | VENDOR | STAFF
  body      String
  fileKey   String?
  createdAt DateTime @default(now())
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  targetType String // PRODUCT | VENDOR | CUSTOMER | REVIEW | CONVERSATION
  targetId   String
  reason     String
  details    String?
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
  reporter   User     @relation(fields: [reporterId], references: [id])

  @@index([targetType, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // vendor.approve, payout.approve, user.suspend ...
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ───────────────────────────── CMS ─────────────────────────────

model HomepageSection {
  id        String   @id @default(cuid())
  key       String   @unique
  type      String // HERO, CATEGORY_GRID, PRODUCT_RAIL, VENDOR_RAIL, SERVICE_RAIL, BANNER, HOW_IT_WORKS, VENDOR_CTA
  title     String?
  subtitle  String?
  config    Json? // { source: "featured" | "new" | "bestsellers" | "trending", limit: 8, ctaLabel, ctaHref }
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Banner {
  id        String    @id @default(cuid())
  placement String // HOME_HERO, HOME_MID, SHOP_TOP
  eyebrow   String?
  title     String
  body      String?
  ctaLabel  String?
  ctaHref   String?
  imageUrl  String?
  tone      String    @default("blue") // blue | charcoal | light
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
}

model CmsPage {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  body           String // Markdown
  seoDescription String?
  published      Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  body        String
  category    String
  coverUrl    String?
  authorId    String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  author      User?     @relation(fields: [authorId], references: [id])
}

model Faq {
  id        String @id @default(cuid())
  category  String
  question  String
  answer    String
  sortOrder Int    @default(0)
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String // PRODUCT_VIEW, STORE_VISIT, ADD_TO_CART
  vendorId  String?
  productId String?
  sessionId String?
  createdAt DateTime @default(now())

  @@index([vendorId, type, createdAt])
  @@index([productId, type])
}

/// File bytes for STORAGE_DRIVER=db (serverless hosts without a writable disk). Keys mirror the
/// local driver: "public/..." files are served by /media, "private/..." only via authorised routes.
model StoredFile {
  key       String   @id
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

// ───────────────────────────── Integrations, payouts, FX, shipping (Nov 2026) ─────────────────────────────

enum ProviderMode {
  SANDBOX
  LIVE
}

enum ProviderApproval {
  NOT_REQUIRED
  NOT_STARTED
  APPLIED
  APPROVED
  REJECTED
}

/// Admin-configured payment or shipping provider. Capabilities come from the code adapter.
model IntegrationProvider {
  id               String           @id @default(cuid())
  key              String           @unique // matches an adapter key, e.g. paystack, shipbubble
  kind             String // PAYMENT | SHIPPING
  name             String
  active           Boolean          @default(false)
  mode             ProviderMode     @default(SANDBOX)
  approval         ProviderApproval @default(NOT_STARTED)
  countries        String[]
  currencies       String[]
  methods          String[]
  credentialsEnc   String? // AES-256-GCM, never sent to the browser
  credentialHint   String? // last 4 characters only
  webhookSecretEnc String?
  feeBps           Int              @default(0) // shipping: platform markup on carrier rates
  priority         Int              @default(100) // lower = preferred when the strategy is RECOMMENDED
  isDefault        Boolean          @default(false)
  minWeightGrams   Int?
  maxWeightGrams   Int?
  zones            String[] // ShippingZone ids; empty = whole country list
  category         String? // AGGREGATOR | NG_COURIER | INTL_EXPRESS | CN_NG_FREIGHT
  feeFixedMinor    BigInt           @default(0)
  notes            String?
  lastCheckAt      DateTime?
  lastCheckOk      Boolean?
  lastCheckMessage String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

/// Which provider pays vendors in a given country/currency. LIVE requires provider approval + compliance sign-off.
model PayoutCorridor {
  id                 String   @id @default(cuid())
  country            String
  currency           String
  providerKey        String
  method             String // LOCAL | CROSS_BORDER
  status             String   @default("DISABLED") // DISABLED | SANDBOX | LIVE
  complianceApproved Boolean  @default(false)
  complianceNote     String?
  minPayoutMinor     BigInt?
  updatedAt          DateTime @updatedAt

  @@unique([country, currency, providerKey])
}

enum BeneficiaryStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  DISABLED
}

/// Vendor payout destination. Only a masked view is stored in clear; full details are encrypted and
/// kept only until the provider has tokenised them (providerRecipientRef).
model Beneficiary {
  id                   String            @id @default(cuid())
  vendorId             String
  providerKey          String
  country              String
  currency             String
  routingType          String // NUBAN | CNAPS | SWIFT | IBAN | ABA | SORT_CODE
  bankName             String
  bankCode             String?
  branch               String?
  accountHolderName    String
  verifiedName         String?
  accountLast4         String
  detailsEnc           String?
  providerRecipientRef String?
  status               BeneficiaryStatus @default(PENDING_VERIFICATION)
  failureReason        String?
  isDefault            Boolean           @default(false)
  verifiedAt           DateTime?
  disabledAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  vendor               Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  payouts              Payout[]

  @@index([vendorId, status])
}

model FxQuote {
  id                String   @id @default(cuid())
  providerKey       String
  sourceCurrency    String
  targetCurrency    String
  sourceAmountMinor BigInt
  targetAmountMinor BigInt
  rate              Decimal  @db.Decimal(24, 12)
  feeMinor          BigInt   @default(0) // in source currency
  providerQuoteRef  String?
  status            String   @default("OPEN") // OPEN | ACCEPTED | EXPIRED
  expiresAt         DateTime
  payoutId          String?  @unique
  createdAt         DateTime @default(now())
  payout            Payout?  @relation(fields: [payoutId], references: [id])
}

model PayoutEvent {
  id        String   @id @default(cuid())
  payoutId  String
  status    String
  message   String?
  payload   Json?
  createdAt DateTime @default(now())
  payout    Payout   @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  @@index([payoutId])
}

/// One row per outbound provider call (no secrets, no full account numbers).
model IntegrationLog {
  id          String   @id @default(cuid())
  providerKey String
  operation   String
  status      String // OK | ERROR
  httpStatus  Int?
  durationMs  Int?
  reference   String?
  message     String?
  createdAt   DateTime @default(now())

  @@index([providerKey, createdAt])
  @@index([status, createdAt])
}

model AdminAlert {
  id           String    @id @default(cuid())
  dedupeKey    String    @unique
  type         String
  severity     String // INFO | WARNING | CRITICAL
  title        String
  detail       String?
  link         String?
  count        Int       @default(1)
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  @@index([resolvedAt, severity])
}

model ReconciliationRecord {
  id                  String   @id @default(cuid())
  runAt               DateTime @default(now())
  providerKey         String
  kind                String // PAYMENT | PAYOUT
  reference           String
  internalAmountMinor BigInt?
  providerAmountMinor BigInt?
  currency            String
  status              String // MATCHED | AMOUNT_MISMATCH | STATUS_MISMATCH | MISSING_AT_PROVIDER | UNVERIFIABLE
  detail              String?

  @@index([runAt])
  @@index([status])
}

model PickupAddress {
  id                   String   @id @default(cuid())
  vendorId             String
  label                String
  contactName          String
  phone                String
  email                String
  line1                String
  line2                String?
  city                 String
  region               String
  postalCode           String?
  country              String
  providerAddressCodes Json? // { "shipbubble": 123 }
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())
  vendor               Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model ShippingQuote {
  id                 String    @id @default(cuid())
  providerKey        String
  vendorId           String
  vendorOrderId      String?
  cartId             String? // checkout quote (before the order exists)
  addressHash        String? // destination the quote is valid for
  methodType         String? // LOCAL_DISPATCH | STANDARD | EXPRESS | AIR_FREIGHT | SEA_FREIGHT
  trackingAvailable  Boolean   @default(true)
  restrictions       String?
  costMinor          BigInt? // carrier price before markup (amountMinor = what the customer pays)
  markupMinor        BigInt    @default(0)
  etaDaysMin         Int?
  etaDaysMax         Int?
  providerRequestRef String?
  courierId          String?
  serviceCode        String
  courierName        String
  amountMinor        BigInt
  currency           String
  etaText            String?
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())

  @@index([vendorOrderId])
  @@index([cartId, vendorId])
}

model CustomsDeclaration {
  id                 String   @id @default(cuid())
  shipmentId         String   @unique
  contents           String
  declaredValueMinor BigInt
  currency           String
  originCountry      String
  hsCodes            String[]
  incoterm           String // DAP (recipient pays duties) | DDP (sender pays)
  insured            Boolean  @default(false)
  items              Json
  createdAt          DateTime @default(now())
  shipment           Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Shipping & freight ─────────────────────────────

/**
 * Delivery zone within a country (e.g. Lagos Mainland, South-West) used to scope providers.
 */
model ShippingZone {
  id        String   @id @default(cuid())
  name      String
  country   String
  regions   String[] // states/provinces in the zone
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([country, name])
}

/**
 * Which order lines travel in a shipment.
 */
model ShipmentItem {
  id          String    @id @default(cuid())
  shipmentId  String
  orderItemId String
  quantity    Int
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  @@unique([shipmentId, orderItemId])
}

model ShipmentLabel {
  id         String   @id @default(cuid())
  shipmentId String
  format     String // PDF | PNG | ZPL | URL
  storageKey String? // private copy when the provider returns the document itself
  url        String? // provider-hosted label
  createdAt  DateTime @default(now())
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

/**
 * Receiving warehouse/hub operated by a freight partner (China origin or Nigeria destination).
 */
model Warehouse {
  id          String             @id @default(cuid())
  code        String             @unique
  name        String
  country     String
  city        String
  address     String
  contactName String?
  phone       String?
  partnerKey  String?
  role        String // ORIGIN | DESTINATION
  active      Boolean            @default(true)
  notes       String?
  createdAt   DateTime           @default(now())
  receipts    WarehouseReceipt[]
}

/**
 * A vendor parcel expected at / received by an origin warehouse.
 */
model WarehouseReceipt {
  id              String                @id @default(cuid())
  warehouseId     String
  vendorId        String
  vendorOrderId   String
  shipmentId      String?               @unique
  inboundCarrier  String?
  inboundTracking String?
  status          String                @default("EXPECTED") // EXPECTED | RECEIVED | CONSOLIDATED | DISPATCHED | EXCEPTION
  weightGrams     Int?
  lengthCm        Int?
  widthCm         Int?
  heightCm        Int?
  pieces          Int                   @default(1)
  receivedAt      DateTime?
  receivedById    String?
  exceptionNote   String?
  consolidationId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  warehouse       Warehouse             @relation(fields: [warehouseId], references: [id])
  shipment        Shipment?             @relation(fields: [shipmentId], references: [id])
  consolidation   FreightConsolidation? @relation(fields: [consolidationId], references: [id])

  @@index([warehouseId, status])
  @@index([vendorOrderId])
}

/**
 * Air or sea consolidation from an origin warehouse to Nigeria, booked with a freight partner.
 */
model FreightConsolidation {
  id                 String             @id @default(cuid())
  reference          String             @unique
  mode               String // AIR | SEA
  partnerKey         String
  originWarehouseId  String
  destinationCountry String             @default("NG")
  status             String             @default("OPEN") // OPEN | BOOKED | DEPARTED | ARRIVED | CUSTOMS | CLEARED | LAST_MILE | CLOSED | CANCELLED
  partnerReference   String?
  quotedCostMinor    BigInt?
  quotedCurrency     String?
  quoteIncludes      String?
  quoteExcludes      String?
  etd                DateTime?
  eta                DateTime?
  departedAt         DateTime?
  arrivedAt          DateTime?
  clearedAt          DateTime?
  createdById        String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  receipts           WarehouseReceipt[]
  shipments          Shipment[]
  events             FreightEvent[]
  invoices           ShippingInvoice[]

  @@index([status])
}

model FreightEvent {
  id              String               @id @default(cuid())
  consolidationId String
  status          String
  note            String?
  location        String?
  actorId         String?
  createdAt       DateTime             @default(now())
  consolidation   FreightConsolidation @relation(fields: [consolidationId], references: [id], onDelete: Cascade)

  @@index([consolidationId, createdAt])
}

/**
 * Carrier / freight partner invoice to XavierConnect (cost side of shipping reconciliation).
 */
model ShippingInvoice {
  id              String                @id @default(cuid())
  providerKey     String
  invoiceNumber   String
  shipmentId      String?
  consolidationId String?
  amountMinor     BigInt
  currency        String
  issuedAt        DateTime
  status          String                @default("UNPAID") // UNPAID | PAID | DISPUTED
  fileKey         String?
  note            String?
  createdById     String
  createdAt       DateTime              @default(now())
  shipment        Shipment?             @relation(fields: [shipmentId], references: [id])
  consolidation   FreightConsolidation? @relation(fields: [consolidationId], references: [id])

  @@unique([providerKey, invoiceNumber])
}

/**
 * Customer return of a delivered sub-order. Refunds go through the normal ledger refund.
 */
model ShippingReturn {
  id               String      @id @default(cuid())
  vendorOrderId    String
  requestedById    String
  reason           String
  details          String?
  status           String      @default("REQUESTED") // REQUESTED | APPROVED | REJECTED | IN_TRANSIT | RECEIVED | REFUNDED | CLOSED
  returnShipmentId String?     @unique
  decidedById      String?
  decidedAt        DateTime?
  decisionNote     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  vendorOrder      VendorOrder @relation(fields: [vendorOrderId], references: [id])
  returnShipment   Shipment?   @relation("ReturnShipment", fields: [returnShipmentId], references: [id])

  @@index([status, createdAt])
}
