# ---------------------------------------------------------------
# XavierConnect environment configuration. Never commit real values.
# ---------------------------------------------------------------

# Core
APP_URL=http://localhost:3000
NODE_ENV=development
# 32+ random bytes, e.g. `openssl rand -hex 32`. Used to sign download links and CSRF tokens.
APP_SECRET=
# 64 hex chars (`openssl rand -hex 32`). Encrypts provider credentials and bank details at rest.
ENCRYPTION_KEY=
# Require TOTP MFA for all staff before /admin opens (keep "true" in production).
ADMIN_MFA_REQUIRED=true

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/xavierconnect
# Same as DATABASE_URL locally. With a pooler (Supabase), DATABASE_URL = transaction pooler (6543, ?pgbouncer=true), DIRECT_URL = session (5432).
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/xavierconnect
# Separate database used only by integration tests (it is wiped on each run)
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/xavierconnect_test

# Redis (rate limiting, background jobs). Optional in development; in-memory fallback is used when empty.
REDIS_URL=

# Payments ---------------------------------------------------------
# "sandbox" = built-in simulated provider (no money moves, clearly labelled in UI).
# "paystack" = live Paystack integration. Requires the keys below.
PAYMENT_PROVIDER=sandbox
# Sandbox is refused when NODE_ENV=production unless this is "true". Only set it on staging/demo servers.
ALLOW_SANDBOX_PAYMENTS=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Email ------------------------------------------------------------
# "console" logs emails to the server log and stores them in the outbox table. "smtp" sends.
EMAIL_TRANSPORT=console
EMAIL_FROM="XavierConnect <no-reply@xavierconnect.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# SMS / WhatsApp (not yet enabled)
TERMII_API_KEY=

# Object storage ---------------------------------------------------
# "local" stores files under ./storage (public/ and private/). "s3" uses any S3-compatible store (AWS, Cloudflare R2).
STORAGE_DRIVER=local
# "db" keeps files in Postgres (StoredFile table) — use on Vercel/serverless.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Seed: initial super administrator (used by `npm run db:seed`)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Sign in with Google (OpenID Connect) ──────────────────────────────────────
# Create an OAuth client ID of type "Web application" in Google Cloud Console → APIs & Services → Credentials.
# Authorised redirect URI must match GOOGLE_REDIRECT_URI exactly, e.g. https://xavierconnect.vercel.app/auth/google/callback
# The button is hidden until both ID and secret are set. The secret is only used server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=          # optional; defaults to $APP_URL/auth/google/callback
# GOOGLE_OIDC_DISCOVERY_URL=  # tests only: a localhost mock issuer. Ignored for any non-localhost URL.

# ── Message attachment malware scanning (optional) ────────────────────────────
# ClamAV daemon (clamd) reachable over TCP. Without it, images are re-encoded + OCR/QR-checked and
# PDFs are always held for a moderator.
CLAMAV_HOST=
CLAMAV_PORT=3310
